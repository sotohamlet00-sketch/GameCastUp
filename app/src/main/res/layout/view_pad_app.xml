<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil «Modo App»: trackpad (pantalla en miniatura) y botones Atrás / Inicio / deslizar. Para Instagram, TikTok, etc. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_pad_panel" android:orientation="vertical" android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="36dp"
        android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/padHandle" style="@style/PadSmall" android:tag="pad_rect" android:layout_width="34dp" android:layout_height="30dp" android:layout_margin="2dp" android:text="✥" />
        <TextView android:id="@+id/padBack" style="@style/PadSmall" android:tag="pad_rect" android:layout_width="64dp" android:layout_height="30dp" android:layout_margin="2dp" android:text="@string/pad_app_back" />
        <TextView android:id="@+id/padClose" style="@style/PadSmall" android:tag="pad_rect" android:layout_width="64dp" android:layout_height="30dp" android:layout_margin="2dp" android:text="⌂" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
            <com.example.gamepadhid.ui.AspectFrameLayout
                android:id="@+id/padTrackFrame"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_gravity="center">
                <TextView
                    android:id="@+id/padTrack"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="3dp" android:background="@drawable/bg_pad_mousepad"
                    android:clickable="true" android:gravity="center"
                    android:text="@string/pad_app_track"
                    android:textAppearance="@style/TextAppearance.Pad.Caption" />
            </com.example.gamepadhid.ui.AspectFrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="64dp" android:layout_height="match_parent"
            android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/padSwipeUp" style="@style/PadRect" android:tag="pad_rect" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="3dp" android:text="⇧" android:textSize="22sp" />
            <TextView android:id="@+id/padSwipeDown" style="@style/PadRect" android:tag="pad_rect" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="3dp" android:text="⇩" android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
