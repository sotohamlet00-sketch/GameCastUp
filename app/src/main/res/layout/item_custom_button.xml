<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView
            android:id="@+id/cbSkin"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_pad_round" android:contentDescription="@null"
            android:padding="2dp" android:scaleType="centerCrop" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:id="@+id/cbLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GC.Body" />
            <TextView
                android:id="@+id/cbState"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GC.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/cbImage" style="@style/GCButtonSecondary" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="@string/cust_btn_image" />
        <TextView android:id="@+id/cbSound" style="@style/GCButtonSecondary" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="@string/cust_btn_sound" />
        <TextView android:id="@+id/cbClear" style="@style/GCButtonSecondary" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="@string/cust_btn_clear" />
    </LinearLayout>
</LinearLayout>
