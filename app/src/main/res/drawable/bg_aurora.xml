<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo aurora: degradados radiales sobre el fondo oscuro (simula vidrio; no hay desenfoque real) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="@color/gc_bg" /></shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:centerX="0.1" android:centerY="0.05"
            android:gradientRadius="75%p" android:startColor="@color/gc_aurora_violet" android:endColor="#00000000" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:centerX="0.95" android:centerY="0.95"
            android:gradientRadius="70%p" android:startColor="@color/gc_aurora_teal" android:endColor="#00000000" />
    </shape></item>
</layer-list>
