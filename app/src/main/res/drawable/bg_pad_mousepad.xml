<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4D9AA7FF" android:endColor="#334A52DE" />
            <stroke android:width="1.5dp" android:color="#99FFFFFF" android:dashWidth="6dp" android:dashGap="4dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1.5dp" android:color="#59FFFFFF" android:dashWidth="6dp" android:dashGap="4dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
